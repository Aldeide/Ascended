.inventory-item-slot {
    width: 64px;
    height: 64px;
    margin: 4px;
    background-color: rgba(30, 30, 45, 0.6);
    border-radius: 8px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.1);
    overflow: hidden;
    justify-content: center;
    align-items: center;
    transition-property: all;
    transition-duration: 0.15s;
    transition-timing-function: ease-out-back;
}

.inventory-item-slot:hover {
    background-color: rgba(60, 60, 80, 0.8);
    border-color: rgba(255, 255, 255, 0.3);
    scale: 1.05;
}

.item-icon-display {
    width: 80%;
    height: 80%;
    -unity-background-scale-mode: scale-to-fit;
}

.item-quantity-label {
    position: absolute;
    bottom: 2px;
    right: 4px;
    font-size: 12px;
    color: white;
    -unity-font-style: bold;
    text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.8);
}

.rarity-border-common { border-color: rgba(150, 150, 150, 0.4); }
.rarity-border-uncommon { border-color: rgba(30, 255, 0, 0.6); }
.rarity-border-rare { border-color: rgba(0, 112, 221, 0.6); }
.rarity-border-epic { border-color: rgba(163, 53, 238, 0.7); }
.rarity-border-legendary { border-color: rgba(255, 128, 0, 0.8); }

.item-hover-effect {
    position: absolute;
    width: 100%;
    height: 100%;
    background-color: white;
    opacity: 0;
    transition-property: opacity;
    transition-duration: 0.1s;
}

.inventory-item-slot:hover .item-hover-effect {
    opacity: 0.05;
}
