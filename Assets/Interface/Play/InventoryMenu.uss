.screen-overlay {
    position: absolute;
    width: 100%;
    height: 100%;
    background-color: rgba(10, 5, 2, 0.65);
    -unity-background-blur-radius: 15px;
    justify-content: center;
    align-items: center;
    visibility: visible;
}

.glass-panel {
    width: 900px;
    height: 600px;
    background-image: linear-gradient(rgba(24, 12, 6, 0.96), rgba(12, 6, 3, 0.92));
    border-radius: 20px;
    border-width: 2.5px;
    border-color: rgba(255, 90, 0, 0.65);
    border-top-color: rgba(255, 165, 45, 0.95);
    border-bottom-color: rgba(255, 50, 0, 0.7);
    padding: 24px;
    margin-left: auto;
    margin-right: 8%;
}

.panel-title {
    font-size: 28px;
    color: #ffa333;
    -unity-font-style: bold;
    letter-spacing: 2px;
    margin-bottom: 20px;
    border-bottom-width: 2px;
    border-color: rgba(255, 90, 0, 0.4);
    -unity-text-outline-color: rgba(255, 50, 0, 0.2);
    -unity-text-outline-width: 0.5px;
}

.horizontal-layout {
    flex-direction: row;
    flex-grow: 1;
}

.section-container {
    flex-grow: 1;
    margin: 10px;
}

.character-preview-box {
    flex-grow: 1;
    background-color: rgba(255, 255, 255, 0.03);
    border-radius: 15px;
    position: relative;
}

.equipment-slot-view {
    position: absolute;
    width: 55px;
    height: 55px;
    border-radius: 8px;
    background-color: rgba(24, 12, 6, 0.6);
    border-width: 1.5px;
    border-color: rgba(255, 90, 0, 0.35);
    justify-content: center;
    align-items: center;
    transition: border-color 0.2s, background-color 0.2s;
}

.equipment-slot-view:hover {
    border-color: rgba(255, 160, 40, 0.85);
    background-color: rgba(40, 20, 10, 0.85);
}

#slot-head { top: 10%; left: 45%; }
#slot-chest { top: 30%; left: 45%; }
#slot-legs { top: 60%; left: 45%; }
#slot-mainhand { top: 35%; left: 15%; }
#slot-offhand { top: 35%; right: 15%; }

.inventory-grid-container {
    flex-grow: 1;
}

.item-grid {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: flex-start;
}

.details-panel {
    height: 120px;
    margin-top: 15px;
    padding: 15px;
    background-color: rgba(0, 0, 0, 0.3);
    border-radius: 10px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.05);
}

.detail-header {
    font-size: 18px;
    color: #ffd700;
    -unity-font-style: bold;
}

.detail-body {
    font-size: 14px;
    color: #cccccc;
    white-space: normal;
}

.hidden {
    display: none;
}

.slot-placeholder-label {
    font-size: 9px;
    color: rgba(255, 255, 255, 0.35);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    width: 100%;
    height: 100%;
    margin: 0;
    padding: 0;
}
