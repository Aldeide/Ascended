<?xml version="1.0" encoding="utf-8"?>
<ui:UXML
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ui="UnityEngine.UIElements"
    xmlns:editor="UnityEditor.UIElements"
    xsi:noNamespaceSchemaLocation="../../../../UIElementsSchema/UIElements.xsd"
>
    <ui:VisualElement style="flex-direction: row; justify-content: space-between; align-items: center; background-color: rgb(60, 60, 70); padding: 10px; margin-bottom: 5px; border-radius: 5px;">
        <ui:Label name="PlayerNameLabel" text="Player Name" style="font-size: 16px; color: rgb(255, 255, 255);" />
        <ui:Label name="ReadyStatusLabel" text="NOT READY" style="font-size: 14px; -unity-font-style: bold; color: rgb(255, 100, 100);" />
    </ui:VisualElement>
</ui:UXML>
